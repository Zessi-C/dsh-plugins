{
  "name": "dsh-model-thinking-levels",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Expose per-model thinking levels (reasoningEfforts) and manual model ordering inside the Models settings card for a custom model API route.",
  "license": "MIT",
  "author": "Zessi-C",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zessi-C/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "models",
    "reasoning-effort"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "homepage": "https://github.com/Zessi-C/dsh-plugins/tree/main/packages/dsh-model-thinking-levels",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tools",
    "locale/*.json",
    "icon.svg"
  ]
}
